# ============================================================
# Seguimiento Actividades Gestiona Forestal 2026 — configuración
# Copie este archivo como .env y complete los valores.
# El archivo .env NO se versiona ni se comparte.
# ============================================================

PUERTO=3080
NODE_ENV=development            # production en el servidor institucional
TRUST_PROXY=                    # vacío = solo loopback. Detrás de un proxy: nº de saltos (Cloud Run = 1) o lista de IP
                                # Si es incorrecto, el límite de intentos de ingreso agrupa a todos los usuarios en una sola IP

# --- Origen de datos -----------------------------------------
# memoria   = demostración con los datos de la matriz de control (se guarda en data/demo-estado.json)
# sqlserver = base de datos institucional (ejecute antes los scripts de db/)
MODO_DATOS=memoria

SQL_SERVIDOR=                   # p. ej. nombre o IP del servidor SQL de la OTI
SQL_PUERTO=1433
SQL_BASE=SGF_SEGUIMIENTO
SQL_USUARIO=usr_sgf_app         # login con el rol sgf_app (ver db/03_seguridad.sql)
SQL_CLAVE=
SQL_CIFRAR=true
SQL_CONFIAR_CERTIFICADO=true    # false si el servidor tiene certificado de una CA reconocida

# --- Sesión y primer administrador -----------------------------
SESION_SECRETO=                 # cadena aleatoria >= 32 caracteres (obligatoria en production)
SESION_HORAS=10
COOKIE_SEGURA=false             # true cuando se publique con HTTPS
ADMIN_CORREO=                   # correo del primer administrador (se crea si no hay usuarios)
ADMIN_NOMBRE=Administrador OTI
ADMIN_CLAVE_INICIAL=            # temporal: se exige cambiarla en el primer ingreso

# --- PDF de los planes aprobados --------------------------------
# Carpeta donde se guardan (por defecto data/planes-pdf; no se versiona). En un despliegue con disco efímero, monte un volumen.
PLANES_PDF_DIR=
ADENDAS_PDF_DIR=
# Originales de los documentos cargados desde Seguimiento Actividades (por defecto data/documentos; no se versiona).
DOCUMENTOS_DIR=

# --- Asistente de IA (Claude Haiku) ----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5   # se usa si el parámetro MODELO_IA está vacío
IA_MAX_TOKENS=2048
IA_MAX_ITERACIONES=8
# Si la salida a internet pasa por un proxy institucional (Node 24 o superior):
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.serfor.gob.pe:8080
