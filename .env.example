# ============================================================
# Seguimiento Actividades Gestiona Forestal 2026 — configuración
# Copie este archivo como .env y complete los valores.
# El archivo .env NO se versiona ni se comparte.
# ============================================================

PUERTO=3080
NODE_ENV=development            # production en el servidor institucional
TRUST_PROXY=                    # vacío = solo loopback. Detrás de un proxy: nº de saltos (Cloud Run = 1) o lista de IP
                                # Si es incorrecto, el límite de intentos de ingreso agrupa a todos los usuarios en una sola IP

# --- Origen de datos -----------------------------------------
# memoria   = demostración con los datos de la matriz de control (se guarda en data/demo-estado.json)
# sqlserver = base de datos institucional (ejecute antes los scripts de db/)
MODO_DATOS=memoria

SQL_SERVIDOR=                   # p. ej. nombre o IP del servidor SQL de la OTI
SQL_PUERTO=1433
SQL_BASE=SGF_SEGUIMIENTO
SQL_USUARIO=usr_sgf_app         # login con el rol sgf_app (ver db/03_seguridad.sql)
SQL_CLAVE=
SQL_CIFRAR=true
SQL_CONFIAR_CERTIFICADO=true    # false si el servidor tiene certificado de una CA reconocida

# --- Sesión y primer administrador -----------------------------
SESION_SECRETO=                 # cadena aleatoria >= 32 caracteres (obligatoria en production)
SESION_HORAS=10
COOKIE_SEGURA=false             # true cuando se publique con HTTPS
ADMIN_CORREO=                   # correo del primer administrador (se crea si no hay usuarios)
ADMIN_NOMBRE=Administrador OTI
ADMIN_CLAVE_INICIAL=            # temporal: se exige cambiarla en el primer ingreso

# --- PDF de los planes aprobados --------------------------------
# Carpeta donde se guardan (por defecto data/planes-pdf; no se versiona). En un despliegue con disco efímero, monte un volumen.
PLANES_PDF_DIR=
ADENDAS_PDF_DIR=
ACTIVIDADES_PDF_DIR=
CONTRATOS_PDF_DIR=
PLANES_ORIGEN_DIR=
# Originales de los documentos cargados desde Seguimiento Actividades (por defecto data/documentos; no se versiona).
DOCUMENTOS_DIR=
# Almacén documental único (db/14): aquí van los PDF nuevos de planes, adendas, OS/contratos y TDR
# (por defecto data/almacen; no se versiona). En producción: C:\datos\seguimiento\almacen
# Las carpetas anteriores se siguen leyendo; herramientas/migrar_documentos.js las indexa en sgf.documento.
DOCUMENTOS_RAIZ=

# --- Asistente de IA (Claude Haiku) ----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5   # se usa si el parámetro MODELO_IA está vacío
IA_MAX_TOKENS=2048
IA_MAX_ITERACIONES=8
# Si la salida a internet pasa por un proxy institucional (Node 24 o superior):
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.serfor.gob.pe:8080

# --- Ingreso con Google Workspace (OpenID Connect) ---------------
# Botón «Ingresar con Google» para cuentas @serfor.gob.pe ya creadas por el Administrador. La clave local sigue valiendo.
SSO_GOOGLE=false                # true para mostrarlo
GOOGLE_CLIENT_ID=               # cliente OAuth de tipo «Aplicación web» (Google Cloud, pantalla de consentimiento interna)
GOOGLE_CLIENT_SECRET=
GOOGLE_DOMINIO=serfor.gob.pe
# URI de redirección autorizada en el cliente OAuth: <URL_APLICACION>/api/auth/google/retorno

# --- Correo diario de alertas (Google Workspace) -----------------
# Un correo por Jefe de Proyecto con las alertas de los proyectos de su equipo (entregables por vencer o vencidos,
# subsanaciones y conformidades fuera de plazo, partes diarios faltantes, OS sin notificar, vigencias por vencer).
ALERTAS_CORREO=false            # true para activarlo
ALERTAS_HORA=07:30              # hora de Lima (HH:MM)
ALERTAS_SOLO_HABILES=true       # no se envía sábados, domingos ni feriados (sgf.feriado)
ALERTAS_COPIA_ADMIN=true        # el Administrador recibe el resumen de todos los proyectos
CORREO_REMITENTE=               # cuenta @serfor.gob.pe que envía (p. ej. una cuenta de servicio de la OTI)
CORREO_NOMBRE=Seguimiento de Proyectos – OTI SERFOR
CORREO_MODO=clave               # clave | cuenta_servicio
CORREO_CLAVE=                   # modo clave: contraseña de aplicación de la cuenta remitente (requiere verificación en dos pasos)
CORREO_CUENTA_SERVICIO_JSON=    # modo cuenta_servicio: ruta del JSON de la cuenta de servicio con delegación de dominio
                                # (alcance https://mail.google.com/), fuera del repositorio
# CORREO_SMTP=smtp.gmail.com    # por defecto
# CORREO_PUERTO=465             # por defecto (SSL)
URL_APLICACION=https://serforia.serfor.gob.pe   # enlace que va en el correo

# --- Reporte mensual para Gerencia por correo (misma cuenta CORREO_*) ---
# El N.° día hábil de cada mes envía el PDF del reporte del mes anterior (todos los proyectos). Una vez por mes.
REPORTE_MENSUAL_CORREO=false    # true para activarlo
REPORTE_MENSUAL_PARA=           # destinatarios separados por coma (p. ej. la Gerencia General)
REPORTE_MENSUAL_DIA_HABIL=1     # 1 = primer día hábil del mes (máximo 15)
REPORTE_MENSUAL_HORA=08:00      # hora de Lima (HH:MM)
REPORTE_MENSUAL_COPIA_ADMIN=true  # los Administradores activos también lo reciben
REPORTE_MENSUAL_MONTOS=false    # true solo si la Dirección decide incluir los montos de las OS (son confidenciales)
