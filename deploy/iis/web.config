<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitio de IIS que publica la aplicación como proxy inverso hacia el servicio de Node.js.
  Requiere los módulos URL Rewrite y Application Request Routing (con el proxy activado: Server Proxy Settings → Enable proxy).

  Dónde va: en la raíz del sitio de IIS. Lo ideal es que esa carpeta contenga SOLO este archivo y que el código de la
  aplicación esté en otra carpeta. Si el código está dentro de la carpeta del sitio, este mismo archivo lo protege:
  todas las rutas se reenvían a Node (IIS no sirve archivos estáticos) y además se ocultan las carpetas internas y el .env.

  Si el servicio usa otro puerto que 3080, cámbielo en la regla «AplicacionNode».
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ForzarHTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="AplicacionNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3080/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- La carga de documentos admite hasta 15 MB; se deja margen -->
        <requestLimits maxAllowedContentLength="20971520" />
        <!-- Defensa adicional: nada de esto es una ruta de la aplicación -->
        <hiddenSegments>
          <add segment="server" />
          <add segment="db" />
          <add segment="data" />
          <add segment="deploy" />
          <add segment="docs" />
          <add segment="herramientas" />
          <add segment="oti-visual" />
          <add segment="test" />
          <add segment="logs" />
          <add segment="node_modules" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
